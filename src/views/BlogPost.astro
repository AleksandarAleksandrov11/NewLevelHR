---
/** Blog article: header, cover, table of contents, prose, share, related posts, CTA. */
import { getEntry, render } from 'astro:content';
import { Clock, Mail, Link2, ArrowLeft, Share2 } from '@lucide/astro';
import PageShell from '@/components/layout/PageShell.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Photo from '@/components/ui/Photo.astro';
import PostCard from '@/components/blog/PostCard.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { type Locale, formatDate } from '@/i18n/config';
import { getDict, fmt, localizePath, type PageKey } from '@/i18n';
import { getPosts, entrySlug, readingTime } from '@/lib/blog';
import { site } from '@/config/site';

interface Props { lang: Locale; pageKey: PageKey | 'blogPost'; postId?: string; path?: string; alternates?: Record<Locale, string> }
const { lang, postId, path, alternates } = Astro.props;
const entry = postId ? await getEntry('blog', postId) : undefined;
if (!entry) throw new Error(`Blog post not found: ${postId}`);
const { Content, headings } = await render(entry);
const d = getDict(lang);
const b = d.blog;
const c = d.common;
const slug = entrySlug(entry);
const pagePath = path ?? localizePath('blog', lang);
const url = `${site.url}${pagePath}`;
const minutes = readingTime(entry.body, entry.data.readingTime);
const category = b.categories[entry.data.category] ?? entry.data.category;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const all = await getPosts(lang);
const related = [...all.filter((p) => p.id !== entry.id && p.data.category === entry.data.category), ...all.filter((p) => p.id !== entry.id && p.data.category !== entry.data.category)].slice(0, 3);
const ogImage = `/og/${lang}/blog/${slug}.png`;
const shareText = encodeURIComponent(entry.data.title);
const shareUrl = encodeURIComponent(url);
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  author: { '@type': 'Person', name: entry.data.author, '@id': `${site.url}/#founder` },
  publisher: { '@id': `${site.url}/#organization` },
  image: `${site.url}${ogImage}`,
  inLanguage: lang,
  mainEntityOfPage: url,
  keywords: entry.data.tags.join(', '),
  articleSection: category,
};
---
<PageShell lang={lang} pageKey="blogPost" path={pagePath} alternates={alternates} title={entry.data.title} description={entry.data.description} image={ogImage} type="article" publishedTime={entry.data.date} modifiedTime={entry.data.updated} jsonLd={[postLd]}>
  <article class="post">
    <header class="post-hero bg-ivory bg-grain">
      <div class="container-site">
        <Breadcrumbs items={[{ label: c.nav.home, href: localizePath('home', lang) }, { label: c.nav.blog, href: localizePath('blog', lang) }, { label: entry.data.title }]} label={c.nav.breadcrumbs} class="mb-8" />
        <div class="post-head">
          <span class="pill pill-accent" data-reveal>{category}</span>
          <h1 class="font-display text-display-lg text-ink mt-5" data-split="immediate">{entry.data.title}</h1>
          <p class="text-lead text-slate mt-6" data-reveal data-reveal-delay="2">{entry.data.description}</p>
          <p class="post-meta" data-reveal data-reveal-delay="3">
            <span><span class="post-meta-label">{b.post.writtenBy}</span> <strong>{entry.data.author}</strong></span>
            <span aria-hidden="true">·</span>
            <span><span class="post-meta-label">{b.post.publishedOn}</span> <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time></span>
            <span aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1"><Clock class="size-4" aria-hidden="true" />{fmt(c.misc.readingTime, { minutes })}</span>
          </p>
        </div>
      </div>
    </header>

    <div class="container-site">
      <figure class="post-cover" data-reveal>
        <Photo name={entry.data.cover ?? 'notebook-desk'} alt={entry.data.coverAlt ?? entry.data.title} ratio="2/1" loading="eager" fetchpriority="high" sizes="(min-width: 80rem) 1312px, 100vw" class="rounded-xl shadow-lift" />
        {entry.data.coverCredit && <figcaption class="mt-3 text-sm text-mist">{entry.data.coverCredit}</figcaption>}
      </figure>
    </div>

    <div class="container-site post-layout">
      {toc.length > 0 && (
        <aside class="post-aside">
          <details class="post-toc" open data-toc>
            <summary class="post-toc-title">{b.post.toc}</summary>
            <ol role="list">
              {toc.map((h) => <li class:list={[h.depth === 3 && 'is-sub']}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </details>
        </aside>
      )}
      <div class="post-body">
        <div class="prose-nl"><Content /></div>

        <div class="post-foot">
          {entry.data.tags.length > 0 && (
            <div class="post-tags"><span class="post-foot-label">{b.post.tags}</span><ul role="list">{entry.data.tags.map((t) => <li class="pill">{t}</li>)}</ul></div>
          )}
          <div class="post-share">
            <span class="post-foot-label"><Share2 class="size-4" aria-hidden="true" />{b.post.share}</span>
            <ul role="list">
              <li><a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label={b.post.shareLinkedIn}><svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></li>
              <li><a class="share-btn" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label={b.post.shareX}><svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21.5l-7.5 8.57L22.8 22h-6.9l-5.4-7.06L4.3 22H1l8.03-9.18L1.2 2h7.07l4.88 6.45L18.24 2Zm-1.2 18h1.9L7.06 3.9H5.02L17.04 20Z" /></svg></a></li>
              <li><a class="share-btn" href={`mailto:?subject=${shareText}&body=${shareUrl}`} aria-label={b.post.shareEmail}><Mail class="size-4" aria-hidden="true" /></a></li>
              <li><button type="button" class="share-btn share-copy" data-copy-link data-label-idle={b.post.copyLink} data-label-done={b.post.copied}><Link2 class="size-4" aria-hidden="true" /><span data-copy-label>{b.post.copyLink}</span></button></li>
            </ul>
          </div>
        </div>

        <aside class="post-cta" data-reveal>
          <h2 class="font-display text-display-sm text-white">{b.post.ctaTitle}</h2>
          <p class="mt-3 text-white/75 leading-relaxed">{b.post.ctaText}</p>
          <div class="mt-6"><Button href={localizePath('contact', lang, 'book')} icon="calendar" cursor="book">{b.post.ctaButton}</Button></div>
        </aside>

        <a href={localizePath('blog', lang)} class="post-back"><ArrowLeft class="size-4" aria-hidden="true" />{b.post.backToBlog}</a>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section bg-ivory bg-grain">
      <div class="container-site">
        <h2 class="font-display text-display-md text-ink" data-reveal>{b.post.related}</h2>
        <div class="post-related">
          {related.map((p, i) => <PostCard post={p} lang={lang} delay={i + 1} />)}
        </div>
      </div>
    </section>
  )}

  <FinalCta lang={lang} />
</PageShell>

<style>
  .post-hero { padding-top: calc(var(--header-h) + clamp(2.5rem, 5vw, 4rem)); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .post-head { max-width: 52rem; }
  .post-head h1 :global(.split-w) { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .post-head h1 :global(.split-i) { display: inline-block; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 1.5rem; font-size: 0.9rem; color: var(--color-slate); }
  .post-meta strong { color: var(--color-ink); }
  .post-meta-label { color: var(--color-mist); }
  .post-cover { margin-top: -1rem; position: relative; z-index: 1; }
  @media (min-width: 64rem) { .post-cover { margin-top: -2rem; } }
  .post-layout { display: grid; gap: 2.5rem; padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  @media (min-width: 64rem) { .post-layout { grid-template-columns: 16rem minmax(0, 44rem); gap: 5rem; justify-content: center; } .post-aside { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; } }
  .post-toc { padding: 1.25rem; border-radius: var(--radius-lg); background: var(--color-ivory); border: 1px solid var(--color-line); }
  .post-toc-title { cursor: pointer; list-style: none; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-mist); }
  .post-toc-title::-webkit-details-marker { display: none; }
  .post-toc ol { display: grid; gap: 0.25rem; margin-top: 0.85rem; }
  .post-toc li.is-sub { padding-left: 0.85rem; }
  .post-toc a { display: block; padding: 0.35rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.875rem; color: var(--color-ink-3); border-left: 2px solid transparent; transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease; }
  .post-toc a:hover { color: var(--color-ink); background: var(--color-sand); }
  .post-toc a.is-active { color: var(--color-accent-ink); border-left-color: var(--color-accent); background: var(--color-accent-soft); }
  .post-foot { display: grid; gap: 1.5rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-line); }
  @media (min-width: 40rem) { .post-foot { grid-template-columns: minmax(0, 1fr) auto; align-items: start; } }
  .post-foot-label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-mist); margin-bottom: 0.6rem; }
  .post-tags ul, .post-share ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .share-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-width: 2.5rem; height: 2.5rem; padding: 0 0.75rem; border-radius: 999px; border: 1px solid var(--color-line-strong); background: var(--color-white); color: var(--color-ink); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease; }
  .share-btn:hover { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .share-copy.is-done { background: var(--color-success-soft); border-color: var(--color-success); color: var(--color-success); }
  .post-cta { margin-top: 3rem; padding: 2rem; border-radius: var(--radius-xl); background: var(--color-ink); position: relative; overflow: hidden; isolation: isolate; }
  .post-cta::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(22rem circle at 90% 0%, rgba(255, 107, 53, 0.3), transparent 60%); }
  .post-back { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 2.5rem; font-weight: 600; color: var(--color-accent-ink); }
  .post-back:hover { color: var(--color-accent-deep); }
  .post-related { display: grid; gap: 1.5rem; margin-top: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40rem) { .post-related { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .post-related { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
</style>
<script>
  import '@/scripts/toc';
</script>
