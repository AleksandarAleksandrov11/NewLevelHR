---
/** A single blog post. */
import { ArrowLeft, Mail } from '@lucide/astro';
import { render } from 'astro:content';
import PageShell from '@/components/layout/PageShell.astro';
import PageHero from '@/components/pages/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, blogPostPath, fmt } from '@/i18n';
import { formatDate, readingMinutes, postSlug, type Post } from '@/lib/blog';
import { site } from '@/config/site';

interface Props { lang: Locale; post: Post; related: Post[]; alternates?: Partial<Record<Locale, string>> }
const { lang, post, related, alternates } = Astro.props;
const d = getDict(lang);
const b = d.blog;
const c = d.common;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
/** Every post opens like every other page: breadcrumbs, title, one line, a photo. */
const photo = { name: post.data.image ?? 'notebook-desk', alt: post.data.imageAlt ?? post.data.title };
const path = blogPostPath(lang, postSlug(post));
const url = `${site.url}${path}`;
/** Share targets. Plain links, so sharing needs no third-party script and no consent. */
const shared = encodeURIComponent(url);
const sharedTitle = encodeURIComponent(post.data.title);
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${shared}`;
const shareX = `https://x.com/intent/post?url=${shared}&text=${sharedTitle}`;
const shareEmail = `mailto:?subject=${sharedTitle}&body=${shared}`;

// A post without translations is its own only language version.
const alts = alternates && Object.keys(alternates).length > 1 ? (alternates as Record<Locale, string>) : ({ [lang]: path } as Record<Locale, string>);
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
  inLanguage: lang,
  mainEntityOfPage: url,
  url,
  author: { '@type': 'Person', name: b.post.author, jobTitle: b.post.authorRole },
  publisher: { '@id': `${site.url}/#organization` },
  keywords: post.data.tags.join(', '),
};
---
<PageShell lang={lang} pageKey="blog" path={path} alternates={alts} title={`${post.data.title} | ${site.name}`} description={post.data.description} jsonLd={[article]} heroPhoto={photo.name}>
  <article class="bp">
    <PageHero
      lang={lang}
      eyebrow={`${formatDate(post.data.date, lang)} · ${fmt(b.post.readingTime, { minutes })}`}
      title={post.data.title}
      text={post.data.description}
      crumbs={[{ label: c.nav.blog, href: localizePath('blog', lang) }, { label: post.data.title }]}
      photo={photo}
    >
      <Button href={localizePath('contact', lang, 'book')} icon="calendar">{c.cta.bookCall}</Button>
      <Button href={localizePath('blog', lang)} variant="ghost" icon="none"><ArrowLeft class="size-4" aria-hidden="true" />{b.post.back}</Button>
    </PageHero>

    <div class="section bg-white pt-0 lg:pt-0">
      <div class="container-prose bp-body prose-nl">
        <Content />
      </div>

      <div class="container-prose bp-foot">
        <a class="bp-back" href={localizePath('blog', lang)}><ArrowLeft class="size-4" aria-hidden="true" />{b.post.back}</a>
        <nav class="bp-share" aria-label={b.post.share}>
          <span class="bp-share-label">{b.post.share}</span>
          <ul role="list">
            <li>
              <a href={shareLinkedIn} class="bp-share-link" target="_blank" rel="noopener noreferrer" title={b.post.shareLinkedIn}>
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13M7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0" /></svg><span class="sr-only">{b.post.shareLinkedIn}</span>
              </a>
            </li>
            <li>
              <a href={shareX} class="bp-share-link" target="_blank" rel="noopener noreferrer" title={b.post.shareX}>
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                <span class="sr-only">{b.post.shareX}</span>
              </a>
            </li>
            <li>
              <a href={shareEmail} class="bp-share-link" title={b.post.shareEmail}>
                <Mail class="size-4" aria-hidden="true" /><span class="sr-only">{b.post.shareEmail}</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {related.length > 0 && (
        <aside class="container-site bp-related" aria-labelledby="bp-related-title">
          <h2 id="bp-related-title" class="font-display text-display-sm text-ink">{b.post.more}</h2>
          <ul class="bp-related-list" role="list">
            {related.map((r) => (
              <li class="card card-hover bp-related-card">
                <p class="bp-related-date">{formatDate(r.data.date, lang)}</p>
                <h3 class="font-display text-lg font-bold text-ink mt-2">
                  <a href={blogPostPath(lang, postSlug(r))}>{r.data.title}</a>
                </h3>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </article>

  <FinalCta lang={lang} />
</PageShell>

<style>

  .bp-body { padding-top: 3rem; }
  .bp-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; }
  .bp-back { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; font-size: 0.9rem; font-weight: 650; color: var(--color-accent-ink); }
  .bp-share { display: flex; align-items: center; gap: 0.85rem; }
  .bp-share-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-slate); }
  .bp-share ul { display: flex; gap: 0.5rem; }
  .bp-share-link {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 999px;
    border: 1px solid var(--color-line-strong); color: var(--color-ink);
    transition: color 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }
  .bp-share-link:hover { color: var(--color-accent-ink); border-color: var(--color-accent); background: var(--color-accent-soft); }
  .bp-back:hover { text-decoration: underline; text-underline-offset: 4px; }

  .bp-related { margin-top: 4rem; }
  .bp-related-list { display: grid; gap: 1.25rem; margin-top: 1.75rem; }
  @media (min-width: 48rem) { .bp-related-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .bp-related-card { position: relative; padding: 1.5rem; }
  .bp-related-date { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-mist); }
  .bp-related-card a { color: inherit; }
  .bp-related-card a::after { content: ''; position: absolute; inset: 0; }
  .bp-related-card:hover a { color: var(--color-accent-ink); }

</style>
