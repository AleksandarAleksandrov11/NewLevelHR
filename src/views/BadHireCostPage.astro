---
/**
 * Cost of a bad hire: its own page, built around the calculator.
 * The hero carries a stack of six bars (one per cost line) instead of a
 * paragraph; below the calculator, the same six lines as a plain strip.
 */
import { Wallet, Search, UserCog, FileMinus, RefreshCw, CalendarX } from '@lucide/astro';
import PageShell from '@/components/layout/PageShell.astro';
import PageHero from '@/components/pages/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import BadHireCalculator from '@/components/home/BadHireCalculator.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';

interface Props { lang: Locale; pageKey: PageKey }
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.tools.cost;
const c = d.common;
const lineIcons = [Wallet, Search, UserCog, FileMinus, RefreshCw, CalendarX];
/** Bar heights of the hero art, one per cost line, stacking up to the total. */
const bars = [42, 66, 92, 122, 156, 196];
---
<PageShell lang={lang} pageKey="badHireCost" title={t.meta.title} description={t.meta.description}>
  <PageHero
    lang={lang}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    facts={t.hero.facts}
    crumbs={[{ label: c.nav.badHireCost }]}
  >
    <Button href="#bad-hire-calculator" icon="arrow">{t.hero.start}</Button>
    <Button href={localizePath('contact', lang, 'book')} variant="ghost" icon="calendar">{c.cta.bookCall}</Button>
    <div class="bh-art" slot="media">
      <svg class="bh-art-svg" viewBox="0 0 240 240" role="presentation" focusable="false">
        <defs>
          <linearGradient id="bh-art-grad" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#ff6b35" /><stop offset="0.6" stop-color="#f7931e" /><stop offset="1" stop-color="#ffb347" />
          </linearGradient>
        </defs>
        <line class="bh-art-base" x1="10" y1="212" x2="230" y2="212" />
        {bars.map((h, i) => (
          <rect
            class="bh-art-bar"
            x={18 + i * 36}
            y={210 - h}
            width="24"
            height={h}
            rx="12"
            style={`--i:${i};--o:${0.34 + i * 0.132}`}
          />
        ))}
      </svg>
    </div>
  </PageHero>

  <BadHireCalculator lang={lang} standalone />

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading title={t.included.title} align="center" size="md" />
      <ol class="bh-lines" role="list">
        {t.included.items.map((item, i) => { const Icon = lineIcons[i] ?? Wallet; return (
          <li class="bh-line" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <span class="bh-line-icon"><Icon class="size-5" aria-hidden="true" /></span>
            <span class="font-display bh-line-title">{item}</span>
          </li>
        ); })}
      </ol>
    </div>
  </section>

  <FinalCta lang={lang} />
</PageShell>

<style>
  /* Hero art: six bars, one per cost line, growing into the total. */
  .bh-art { position: relative; width: min(24rem, 100%); max-height: 100%; aspect-ratio: 1; }
  .bh-art::before {
    content: ''; position: absolute; inset: 10% 6% 18%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 179, 71, 0.3), transparent 70%);
  }
  .bh-art-svg { position: relative; width: 100%; height: 100%; }
  .bh-art-base { stroke: var(--color-line-strong); stroke-width: 2; stroke-dasharray: 2 8; stroke-linecap: round; }
  .bh-art-bar { fill: url(#bh-art-grad); opacity: var(--o, 1); transform-box: fill-box; transform-origin: bottom; }
  @media (prefers-reduced-motion: no-preference) {
    .js-motion .bh-art-bar { animation: bh-art-grow 0.8s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 0.1s + 0.2s); }
  }
  @keyframes bh-art-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  /* Cost lines: icon and label only, no explanatory copy. */
  .bh-lines { display: grid; gap: 0.75rem; margin-top: 2.5rem; }
  @media (min-width: 40rem) { .bh-lines { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .bh-lines { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } }
  .bh-line {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 1rem 1.15rem; border-radius: var(--radius-lg);
    background: var(--color-ivory); border: 1px solid var(--color-line);
  }
  .bh-line-icon {
    display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem;
    border-radius: 0.8rem; background: var(--color-accent-soft); color: var(--color-accent-ink);
  }
  .bh-line-title { font-size: 1rem; font-weight: 700; line-height: 1.3; color: var(--color-ink); }
</style>
