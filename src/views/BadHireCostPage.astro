---
/**
 * Cost of a bad hire: its own page, built around the calculator.
 * The page lists what the total is made of and says plainly that the number
 * is about the visitor's company, not about our fee.
 */
import { Wallet, Search, UserCog, FileMinus, RefreshCw, CalendarX, Info, ShieldCheck } from '@lucide/astro';
import PageShell from '@/components/layout/PageShell.astro';
import PageHero from '@/components/pages/PageHero.astro';
import BadHireCalculator from '@/components/home/BadHireCalculator.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';

interface Props { lang: Locale; pageKey: PageKey }
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.tools.cost;
const c = d.common;
const lineIcons = [Wallet, Search, UserCog, FileMinus, RefreshCw, CalendarX];
---
<PageShell lang={lang} pageKey="badHireCost" title={t.meta.title} description={t.meta.description}>
  <PageHero
    lang={lang}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
    crumbs={[{ label: c.nav.badHireCost }]}
    variant="ivory"
    align="center"
  >
    <div class="bh-hero-actions">
      <Button href="#bad-hire-calculator" size="lg" icon="arrow">{t.hero.start}</Button>
      <p class="bh-hero-note"><ShieldCheck class="size-4" aria-hidden="true" /><span>{t.privacy}</span></p>
    </div>
  </PageHero>

  <BadHireCalculator lang={lang} standalone />

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading eyebrow={c.nav.badHireCost} title={t.included.title} align="center" size="md" />
      <ol class="bh-lines" role="list">
        {t.included.items.map((item, i) => { const Icon = lineIcons[i] ?? Wallet; return (
          <li class="card bh-line" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <span class="bh-line-icon"><Icon class="size-5" aria-hidden="true" /></span>
            <div>
              <h3 class="font-display bh-line-title">{item.title}</h3>
              <p class="bh-line-body">{item.body}</p>
            </div>
          </li>
        ); })}
      </ol>
    </div>
  </section>

  <section class="section bg-ivory bg-grain pt-0 lg:pt-0">
    <div class="container-site">
      <div class="bh-note" data-reveal>
        <span class="bh-note-icon"><Info class="size-5" aria-hidden="true" /></span>
        <div>
          <p class="font-display bh-note-title">{t.notPrice.title}</p>
          <p class="mt-2 text-slate leading-relaxed">{t.notPrice.text}</p>
        </div>
      </div>

      <div class="bh-cross" data-reveal data-reveal-delay="1">
        <div>
          <p class="font-display bh-cross-title">{t.otherTool.title}</p>
          <p class="mt-2 text-slate">{t.otherTool.text}</p>
        </div>
        <Button href={localizePath('healthCheck', lang)} variant="secondary">{t.otherTool.button}</Button>
      </div>
    </div>
  </section>

  <FinalCta lang={lang} />
</PageShell>

<style>
  .bh-hero-actions { margin-top: 2rem; display: grid; justify-items: center; gap: 1rem; }
  .bh-hero-note { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-slate); max-width: 34rem; text-align: left; }
  .bh-hero-note :global(svg) { flex: none; color: var(--color-accent-ink); }

  .bh-lines { display: grid; gap: 1rem; margin-top: 2.5rem; }
  @media (min-width: 48rem) { .bh-lines { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; } }
  @media (min-width: 72rem) { .bh-lines { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bh-line { display: flex; align-items: flex-start; gap: 1rem; padding: 1.5rem; }
  .bh-line-icon { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 0.8rem; background: var(--color-accent-soft); color: var(--color-accent-ink); }
  .bh-line-title { font-size: 1.0625rem; font-weight: 700; line-height: 1.3; color: var(--color-ink); }
  .bh-line-body { margin-top: 0.4rem; font-size: 0.9rem; line-height: 1.6; color: var(--color-slate); }

  .bh-note {
    display: flex; align-items: flex-start; gap: 1.25rem;
    padding: 2rem; border-radius: var(--radius-xl);
    background: var(--color-white); border: 1px solid var(--color-line-strong);
    max-width: 52rem; margin-inline: auto;
  }
  .bh-note-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 0.9rem; background: var(--color-accent-soft); color: var(--color-accent-ink); }
  .bh-note-title { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-ink); }

  .bh-cross {
    margin: 2rem auto 0; max-width: 52rem; padding: 1.75rem; border-radius: var(--radius-xl);
    background: var(--color-white); border: 1px solid var(--color-line);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem;
  }
  .bh-cross-title { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.015em; color: var(--color-ink); }
</style>
