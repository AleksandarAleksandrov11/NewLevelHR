---
/** Temporary view used while pages are being built. */
import type { Locale } from '@/i18n/config';
interface Props { lang: Locale; view: string }
const { lang, view } = Astro.props;
---
<section class="section container-site">
  <p class="eyebrow">{view}</p>
  <h1 class="text-display-lg font-display mt-4">Under construction ({lang})</h1>
</section>
