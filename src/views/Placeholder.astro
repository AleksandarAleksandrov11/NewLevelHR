---
/** Temporary view used while pages are being built. */
import PageShell from '@/components/layout/PageShell.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import type { Locale } from '@/i18n/config';
import type { PageKey } from '@/i18n/routes';
interface Props { lang: Locale; view: PageKey | 'blogPost'; path?: string; alternates?: Record<Locale, string> }
const { lang, view, path, alternates } = Astro.props;
---
<PageShell lang={lang} pageKey={view} path={path} alternates={alternates} title={`${view}`} description="Under construction" noindex>
  <section class="section container-site pt-40">
    <p class="eyebrow">{view}</p>
    <h1 class="text-display-lg font-display mt-4" data-split>Under construction ({lang})</h1>
    <p class="text-lead text-slate mt-6 max-w-2xl" data-reveal>This view has not been built yet. The header, footer, cookie banner and language banner are shared across all pages.</p>
  </section>
  <FinalCta lang={lang} />
</PageShell>
