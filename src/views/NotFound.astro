---
/** Per-language 404 page (/en/404/, /de/404/, /bg/404/). */
import PageShell from '@/components/layout/PageShell.astro';
import NotFoundContent from '@/components/pages/NotFoundContent.astro';
import type { Locale } from '@/i18n/config';
import { getDict, type PageKey } from '@/i18n';
interface Props { lang: Locale; pageKey: PageKey }
const { lang } = Astro.props;
const n = getDict(lang).common.notFound;
---
<PageShell lang={lang} pageKey="notFound" title={n.title} description={n.text} noindex>
  <NotFoundContent lang={lang} />
</PageShell>
