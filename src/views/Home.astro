---
import PageShell from '@/components/layout/PageShell.astro';
import { type Locale } from '@/i18n/config';
import { getDict } from '@/i18n';
import Hero from '@/components/home/Hero.astro';
import Marquee from '@/components/home/Marquee.astro';
import Manifesto from '@/components/home/Manifesto.astro';
import Problems from '@/components/home/Problems.astro';
import Services from '@/components/home/Services.astro';
import Bridge from '@/components/home/Bridge.astro';
import Comparison from '@/components/home/Comparison.astro';
import HealthCheck from '@/components/home/HealthCheck.astro';
import BadHireCalculator from '@/components/home/BadHireCalculator.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import FaqTeaser from '@/components/home/FaqTeaser.astro';
import FinalCta from '@/components/sections/FinalCta.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NewLevelHR',
  url: `${Astro.site}`.replace(/\/$/, ''),
  inLanguage: lang,
};
---
<PageShell lang={lang} pageKey="home" title={d.home.meta.title} description={d.home.meta.description} transparentHeader jsonLd={[website]} bodyClass="page-home">
  <div data-page-home>
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <Manifesto lang={lang} />
    <Problems lang={lang} />
    <Services lang={lang} />
    <Bridge lang={lang} />
    <Comparison lang={lang} />
    <HealthCheck lang={lang} />
    <BadHireCalculator lang={lang} />
    <Testimonials lang={lang} />
    <FaqTeaser lang={lang} />
    <FinalCta lang={lang} />
  </div>
</PageShell>
<script>
  import '@/scripts/home';
</script>
