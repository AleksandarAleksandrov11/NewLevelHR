---
/** Services overview: four services, how we work, how to choose. */
import { ArrowRight, MessageCircle, Zap, HeartHandshake, Target } from '@lucide/astro';
import PageShell from '@/components/layout/PageShell.astro';
import PageHero from '@/components/pages/PageHero.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Photo from '@/components/ui/Photo.astro';
import CheckList from '@/components/services/CheckList.astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';
import { site } from '@/config/site';

interface Props { lang: Locale; pageKey: PageKey }
const { lang } = Astro.props;
const d = getDict(lang);
const s = d.services;
const c = d.common;
type Short = 'fractional' | 'hiring' | 'bridge' | 'coaching';
const keyOf: Record<Short, PageKey> = { fractional: 'serviceFractional', hiring: 'serviceHiring', bridge: 'serviceBridge', coaching: 'serviceCoaching' };
const cards = s.cards.map((card, i) => ({ ...card, short: card.key as Short, index: String(i + 1).padStart(2, '0'), name: c.services[card.key as Short].name, tagline: c.services[card.key as Short].tagline, href: localizePath(keyOf[card.key as Short], lang) }));
const valueIcons = [Zap, HeartHandshake, Target];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: cards.map((card, i) => ({ '@type': 'ListItem', position: i + 1, name: card.name, url: `${site.url}${card.href}` })),
};
---
<PageShell lang={lang} pageKey="services" title={s.meta.title} description={s.meta.description} jsonLd={[itemList]}>
  <PageHero lang={lang} eyebrow={s.hero.eyebrow} title={s.hero.title} text={s.hero.text} crumbs={[{ label: c.nav.services }]} photo={{ name: 'team-celebration', alt: s.hero.imageAlt }}>
    <Button href={localizePath('contact', lang, 'book')} icon="calendar">{s.labels.bookCall}</Button>
    <Button href="#services-list" variant="ghost" icon="none">{s.cardsSection.eyebrow}<ArrowRight class="size-4 rotate-90" aria-hidden="true" /></Button>
  </PageHero>

  <section id="services-list" class="section bg-white">
    <div class="container-site">
      <SectionHeading eyebrow={s.cardsSection.eyebrow} title={s.cardsSection.title} text={s.cardsSection.text} />
      <div class="svc-rows">
        {cards.map((card, i) => (
          <article class:list={['svc-row', i % 2 === 1 && 'is-reverse']} data-reveal>
            <a href={card.href} class="svc-row-media" aria-hidden="true" tabindex="-1">
              <Photo name={card.image} alt="" ratio="4/3" sizes="(min-width: 64rem) 45vw, 100vw" class="rounded-xl" />
              <span class="svc-row-index font-display">{card.index}</span>
            </a>
            <div class="svc-row-body">
              <p class="eyebrow">{card.tagline}</p>
              <h3 class="font-display text-display-sm text-ink mt-3"><a href={card.href} class="svc-row-link">{card.name}</a></h3>
              <p class="text-slate mt-4 leading-relaxed">{card.summary}</p>
              <CheckList items={card.bullets} class="mt-6" />
              <div class="mt-7"><Button href={card.href} variant="secondary">{s.labels.exploreService}</Button></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white relative overflow-hidden">
    <div class="svc-glow" aria-hidden="true"></div>
    <div class="container-site">
      <SectionHeading eyebrow={s.intro.eyebrow} title={s.intro.title} text={s.intro.text} dark />
      <div class="svc-points">
        {s.intro.points.map((p, i) => (
          <div class="svc-point" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="svc-point-num font-display">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display text-xl font-bold mt-3">{p.title}</h3>
            <p class="mt-3 text-white/70 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
      <h3 class="mt-16 text-sm font-bold uppercase tracking-[0.16em] text-white/60" data-reveal>{s.intro.valuesTitle}</h3>
      <ul class="svc-values" role="list">
        {s.intro.values.map((v, i) => { const Icon = valueIcons[i] ?? Zap; return (
          <li data-reveal data-reveal-delay={String(i + 1)}>
            <span class="svc-value-icon"><Icon class="size-5" aria-hidden="true" /></span>
            <div><p class="font-display font-bold text-lg">{v.title}</p><p class="mt-1 text-white/70">{v.body}</p></div>
          </li>
        ); })}
      </ul>
    </div>
  </section>

  <section class="section bg-mesh">
    <div class="container-site">
      <div class="svc-choose">
        <div class="svc-choose-main">
          <SectionHeading eyebrow={s.howToChoose.eyebrow} title={s.howToChoose.title} text={s.howToChoose.text} size="md" />
          <ul class="svc-options" role="list">
            {s.howToChoose.options.map((o, i) => { const short = o.service as Short; return (
              <li data-reveal data-reveal-delay={String(i + 1)}>
                <a href={localizePath(keyOf[short], lang)} class="svc-option group">
                  <span class="svc-option-when">{o.when}</span>
                  <span class="svc-option-to"><span class="text-mist text-xs font-bold uppercase tracking-wider">{s.howToChoose.optionLabel}</span><span class="font-display font-bold text-ink">{c.services[short].name}</span><ArrowRight class="size-4 text-accent-ink transition-transform group-hover:translate-x-1" aria-hidden="true" /></span>
                </a>
              </li>
            ); })}
          </ul>
        </div>
        <aside class="svc-choose-aside">
          <div class="svc-aside-card" data-reveal data-reveal-delay="2">
            <MessageCircle class="size-6 text-accent-ink" aria-hidden="true" />
            <h3 class="font-display text-xl font-bold mt-4">{s.howToChoose.callTitle}</h3>
            <p class="mt-2 text-slate leading-relaxed">{s.howToChoose.callText}</p>
            <div class="mt-5"><Button href={localizePath('contact', lang, 'book')} icon="calendar">{s.howToChoose.callButton}</Button></div>
          </div>
          <div class="svc-aside-card" data-reveal data-reveal-delay="3">
            <h3 class="font-display text-xl font-bold">{s.howToChoose.checkTitle}</h3>
            <p class="mt-2 text-slate leading-relaxed">{s.howToChoose.checkText}</p>
            <div class="mt-5"><Button href={localizePath('home', lang, 'health-check')} variant="ghost">{s.howToChoose.checkButton}</Button></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <FinalCta lang={lang} />
</PageShell>

<style>
  .svc-rows { display: grid; gap: clamp(3rem, 6vw, 6rem); margin-top: 4rem; }
  .svc-row { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 64rem) { .svc-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; } .svc-row.is-reverse .svc-row-media { order: 2; } }
  .svc-row-media { position: relative; display: block; overflow: hidden; border-radius: var(--radius-xl); }
  .svc-row-media :global(.photo-img) { transition: transform 1.2s var(--ease-out-expo); }
  .svc-row-media:hover :global(.photo-img) { transform: scale(1.05); }
  .svc-row-index { position: absolute; left: 1.25rem; top: 1rem; font-size: clamp(2.5rem, 2rem + 2vw, 4rem); font-weight: 800; letter-spacing: -0.04em; color: #fff; text-shadow: 0 2px 24px rgba(20, 20, 28, 0.35); }
  .svc-row-link { color: inherit; }
  .svc-row-link:hover { color: var(--color-accent-ink); }
  .svc-glow { position: absolute; width: 50vw; height: 50vw; max-width: 44rem; max-height: 44rem; right: -18vw; top: -18vw; border-radius: 50%; background: radial-gradient(circle, rgba(255, 107, 53, 0.24), transparent 65%); filter: blur(20px); pointer-events: none; }
  .svc-points { display: grid; gap: 1.5rem; margin-top: 3.5rem; }
  @media (min-width: 48rem) { .svc-points { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
  .svc-point { padding: 1.75rem; border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); }
  .svc-point-num { font-size: 0.9rem; font-weight: 800; color: var(--color-accent-3); letter-spacing: 0.05em; }
  .svc-values { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  @media (min-width: 48rem) { .svc-values { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
  .svc-values li { display: flex; gap: 1rem; align-items: flex-start; }
  .svc-value-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 0.9rem; background: rgba(255, 107, 53, 0.15); color: var(--color-accent-3); }
  .svc-choose { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .svc-choose { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 4rem; align-items: start; } }
  .svc-options { display: grid; gap: 0.75rem; margin-top: 2.5rem; }
  .svc-option { display: grid; gap: 0.75rem; padding: 1.25rem 1.4rem; border-radius: var(--radius-lg); background: var(--color-white); border: 1px solid var(--color-line); box-shadow: var(--shadow-soft); transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo), border-color 0.4s ease; }
  @media (min-width: 40rem) { .svc-option { grid-template-columns: minmax(0, 1.4fr) auto; align-items: center; gap: 1.5rem; } }
  .svc-option:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); border-color: rgba(255, 107, 53, 0.35); }
  .svc-option-when { color: var(--color-ink-2); line-height: 1.5; }
  .svc-option-to { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; white-space: nowrap; }
  .svc-choose-aside { display: grid; gap: 1.25rem; }
  .svc-aside-card { padding: 1.75rem; border-radius: var(--radius-lg); background: var(--color-white); border: 1px solid var(--color-line); box-shadow: var(--shadow-soft); }
</style>
