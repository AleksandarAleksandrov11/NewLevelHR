---
/**
 * HR Health Check: its own page, built around the five-question quiz.
 * The hero carries a five-segment ring (one segment per area the check looks
 * at) instead of a paragraph; below it, the areas as a plain strip and the
 * check itself. Nothing leaves the browser.
 */
import { Clock, Users, Coins, UserPlus, FileCheck } from '@lucide/astro';
import PageShell from '@/components/layout/PageShell.astro';
import PageHero from '@/components/pages/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import HealthCheck from '@/components/home/HealthCheck.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';

interface Props { lang: Locale; pageKey: PageKey }
const { lang } = Astro.props;
const d = getDict(lang);
const h = d.tools.health;
const c = d.common;
const areaIcons = [Clock, Users, Coins, UserPlus, FileCheck];
const segments = [0, 1, 2, 3, 4];
---
<PageShell lang={lang} pageKey="healthCheck" title={h.meta.title} description={h.meta.description}>
  <PageHero
    lang={lang}
    eyebrow={h.hero.eyebrow}
    title={h.hero.title}
    crumbs={[{ label: c.nav.healthCheck }]}
  >
    <Button href="#health-check" icon="arrow">{h.hero.start}</Button>
    <Button href={localizePath('contact', lang, 'book')} variant="ghost" icon="calendar">{c.cta.bookCall}</Button>
    <div class="hc-art" slot="media">
      <svg class="hc-art-svg" viewBox="0 0 240 240" role="presentation" focusable="false">
        <defs>
          <linearGradient id="hc-art-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff6b35" /><stop offset="0.55" stop-color="#f7931e" /><stop offset="1" stop-color="#ffb347" />
          </linearGradient>
        </defs>
        <g transform="rotate(-90 120 120)">
          {segments.map((i) => (
            <circle class="hc-art-track" cx="120" cy="120" r="96" pathLength="100" stroke-dasharray="16 84" stroke-dashoffset={-i * 20} />
          ))}
          {segments.map((i) => (
            <circle class="hc-art-seg" cx="120" cy="120" r="96" pathLength="100" stroke-dashoffset={-i * 20} style={`--i:${i}`} />
          ))}
        </g>
      </svg>
      <span class="hc-art-num font-display">5</span>
    </div>
  </PageHero>

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading title={h.areas.title} align="center" size="md" />
      <ol class="hc-areas" role="list">
        {h.areas.items.map((item, i) => { const Icon = areaIcons[i] ?? Clock; return (
          <li class="hc-area" data-reveal data-reveal-delay={String((i % 5) + 1)}>
            <span class="hc-area-icon"><Icon class="size-5" aria-hidden="true" /></span>
            <span class="font-display hc-area-title">{item}</span>
          </li>
        ); })}
      </ol>
    </div>
  </section>

  <HealthCheck lang={lang} standalone />

  <FinalCta lang={lang} />
</PageShell>

<style>
  /* Hero art: five ring segments, one per area, drawn in sequence. */
  .hc-art { position: relative; width: min(24rem, 100%); max-height: 100%; aspect-ratio: 1; display: grid; place-items: center; }
  .hc-art::before {
    content: ''; position: absolute; inset: 12%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 179, 71, 0.32), transparent 70%);
  }
  .hc-art-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hc-art-track { fill: none; stroke: var(--color-line-strong); stroke-width: 10; stroke-linecap: round; }
  .hc-art-seg { fill: none; stroke: url(#hc-art-grad); stroke-width: 10; stroke-linecap: round; stroke-dasharray: 16 84; }
  .hc-art-num {
    position: relative; font-size: clamp(4.5rem, 3rem + 9vw, 7.5rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 1; color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .js-motion .hc-art-seg { animation: hc-art-draw 0.9s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 0.12s + 0.25s); }
    .js-motion .hc-art-num { animation: hc-art-in 0.8s var(--ease-out-expo) 0.15s both; }
  }
  @keyframes hc-art-draw { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 16 84; } }
  @keyframes hc-art-in { from { opacity: 0; transform: scale(0.88); } to { opacity: 1; transform: none; } }

  /* Areas: icon and label only, no explanatory copy. */
  .hc-areas { display: grid; gap: 0.75rem; margin-top: 2.5rem; }
  @media (min-width: 40rem) { .hc-areas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .hc-areas { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; } }
  .hc-area {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 1rem 1.15rem; border-radius: var(--radius-lg);
    background: var(--color-ivory); border: 1px solid var(--color-line);
  }
  @media (min-width: 72rem) { .hc-area { flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.5rem 1.25rem; } }
  .hc-area-icon {
    display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem;
    border-radius: 0.8rem; background: var(--color-accent-soft); color: var(--color-accent-ink);
  }
  .hc-area-title { font-size: 1rem; font-weight: 700; line-height: 1.3; color: var(--color-ink); }
</style>
