---
/**
 * The standard inner-page hero, used by every page below the home page:
 * breadcrumbs, eyebrow, title, one lead line (or a row of short facts), the
 * page's call-to-action buttons on the left, and a photo — or, on the tool
 * pages, a custom visual in the `media` slot — on the right. Same background,
 * same rhythm and the same media ratio everywhere, so the heroes line up.
 */
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Photo from '@/components/ui/Photo.astro';

interface Crumb { label: string; href?: string }
interface Props {
  lang: Locale;
  eyebrow?: string;
  title: string;
  text?: string;
  /** Short facts shown instead of a lead paragraph (the tool pages use this). */
  facts?: readonly string[];
  crumbs: Crumb[];
  photo?: { name: string; alt: string };
  variant?: 'ivory' | 'mesh' | 'dark' | 'white';
  align?: 'left' | 'center';
  class?: string;
}
const { lang, eyebrow, title, text, facts, crumbs, photo, variant = 'mesh', align = 'left', class: className = '' } = Astro.props;
const c = getDict(lang).common;
const allCrumbs: Crumb[] = [{ label: c.nav.home, href: localizePath('home' as PageKey, lang) }, ...crumbs];
const dark = variant === 'dark';
const bg = { ivory: 'bg-ivory bg-grain', mesh: 'bg-mesh', dark: 'bg-ink text-white', white: 'bg-white' }[variant];
const hasMedia = Boolean(photo) || Astro.slots.has('media');
---
<section class:list={['page-hero', bg, dark && 'page-hero-dark', hasMedia && 'has-photo', className]}>
  <div class="page-hero-grid container-site">
    <div class:list={['page-hero-copy', align === 'center' && 'is-center']}>
      <Breadcrumbs items={allCrumbs} label={c.nav.breadcrumbs} light={dark} class="mb-8" />
      {eyebrow && <p class:list={['eyebrow', dark && 'text-accent-3']} data-reveal>{eyebrow}</p>}
      <h1 class:list={['font-display text-display-lg mt-5', dark ? 'text-white' : 'text-ink']} data-split="immediate">{title}</h1>
      {text && <p class:list={['text-lead mt-6 max-w-2xl', dark ? 'text-white/75' : 'text-slate', align === 'center' && 'mx-auto']} data-reveal data-reveal-delay="2">{text}</p>}
      {facts && (
        <ul class="page-hero-facts" role="list" data-reveal data-reveal-delay="2">
          {facts.map((fact) => <li>{fact}</li>)}
        </ul>
      )}
      <div class="page-hero-actions" data-reveal data-reveal-delay="4"><slot /></div>
    </div>
    {hasMedia && (
      <div class="page-hero-media" data-reveal data-reveal-delay="2" data-parallax-scope>
        {photo ? (
          <div data-parallax="0.1"><Photo name={photo.name} alt={photo.alt} ratio="4/3" loading="eager" fetchpriority="high" sizes="(min-width: 64rem) 45vw, 100vw" class="rounded-xl shadow-lift" /></div>
        ) : (
          <div class="page-hero-art"><slot name="media" /></div>
        )}
      </div>
    )}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding-top: calc(var(--header-h) + clamp(2.5rem, 5vw, 4.5rem)); padding-bottom: clamp(3rem, 5vw, 5rem); }
  .page-hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 64rem) {
    .has-photo .page-hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 4rem; }
    /* One floor for every hero, so pages with a short headline are no shorter
       than the rest and the site keeps a single opening rhythm. */
    .page-hero { min-height: 44rem; display: grid; align-content: center; }
  }
  .page-hero-copy.is-center { text-align: center; margin-inline: auto; max-width: 52rem; }
  .page-hero-copy.is-center :global(nav ol) { justify-content: center; }
  .page-hero-copy.is-center .eyebrow { justify-content: center; }
  .page-hero-copy.is-center ul { justify-content: center; }
  .page-hero-copy.is-center .page-hero-actions { justify-content: center; }
  .page-hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .page-hero-actions:empty { display: none; }
  .page-hero-facts {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.75rem;
    font-size: 0.9rem; font-weight: 600; color: var(--color-slate);
  }
  .page-hero-facts li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .page-hero-facts li::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--color-accent); }
  /* The art sits in the same box a photo would, so every hero is the same height. */
  .page-hero-art { display: grid; place-items: center; aspect-ratio: 4 / 3; }
  .page-hero h1 :global(.split-w) { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .page-hero h1 :global(.split-i) { display: inline-block; }
  .page-hero-dark :global(.eyebrow::before) { background: var(--color-accent-3); }
  .page-hero-dark .page-hero-facts { color: rgba(255, 255, 255, 0.75); }
</style>
