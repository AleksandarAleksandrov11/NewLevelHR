---
/** Playful 404 content, reused by the per-language page and the root fallback. */
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const n = d.common.notFound;
---
<section class="nf bg-mesh" lang={lang}>
  <div class="container-site nf-grid">
    <div class="nf-copy">
      <p class="eyebrow" data-reveal>{n.eyebrow}</p>
      <p class="nf-code font-display" aria-hidden="true">404</p>
      <h1 class="font-display text-display-md text-ink mt-2" data-reveal data-reveal-delay="1">{n.title}</h1>
      <p class="text-lead text-slate mt-5 max-w-xl" data-reveal data-reveal-delay="2">{n.text}</p>
      <p class="mt-3 text-sm font-medium text-accent-ink" data-reveal data-reveal-delay="3">{n.joke}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="4">
        <Button href={localizePath('home', lang)} icon="arrow">{n.home}</Button>
        <Button href={localizePath('services', lang)} variant="secondary">{n.services}</Button>
        <Button href={localizePath('contact', lang)} variant="ghost">{n.contact}</Button>
      </div>
    </div>
    <svg class="nf-art" viewBox="0 0 320 260" aria-hidden="true" data-reveal data-reveal-delay="2">
      <defs><linearGradient id="nf-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff6b35" /><stop offset="1" stop-color="#ffb347" /></linearGradient></defs>
      <rect x="10" y="190" width="60" height="70" rx="12" fill="#ffb347" />
      <rect x="85" y="150" width="60" height="110" rx="12" fill="#f7931e" />
      <rect class="nf-missing" x="160" y="105" width="60" height="155" rx="12" fill="none" stroke="#ff6b35" stroke-width="3" stroke-dasharray="10 8" />
      <rect x="235" y="40" width="60" height="220" rx="12" fill="url(#nf-g)" />
      <text x="190" y="190" text-anchor="middle" font-family="Manrope Variable, sans-serif" font-weight="800" font-size="34" fill="#c2410c">?</text>
    </svg>
  </div>
</section>
<style>
  .nf { padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5rem)); padding-bottom: clamp(4rem, 8vw, 7rem); min-height: 70vh; display: grid; align-items: center; }
  .nf-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 64rem) { .nf-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 5rem; } }
  .nf-code { font-size: clamp(5rem, 4rem + 8vw, 11rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.06em; background: var(--grad-accent); -webkit-background-clip: text; background-clip: text; color: transparent; margin-top: 0.5rem; }
  .nf-art { width: min(100%, 22rem); margin-inline: auto; }
  .nf-missing { animation: nf-blink 2.4s ease-in-out infinite; }
  @keyframes nf-blink { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .nf-missing { animation: none; } }
</style>
