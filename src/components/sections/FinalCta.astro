---
/** Full-bleed orange call-to-action used at the end of most pages. */
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';

interface Props { lang: Locale; title?: string; text?: string; eyebrow?: string; class?: string }
const { lang, title, text, eyebrow, class: className = '' } = Astro.props;
const c = getDict(lang).common;
---
<section class:list={['final-cta section', className]} aria-labelledby="final-cta-title">
  <div class="final-cta-bg" aria-hidden="true">
    <span class="orb orb-1"></span><span class="orb orb-2"></span><span class="orb orb-3"></span>
    <svg class="steps" viewBox="0 0 400 300" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
      <rect x="40" y="200" width="90" height="100" rx="10" fill="rgba(255,255,255,0.10)" />
      <rect x="150" y="130" width="90" height="170" rx="10" fill="rgba(255,255,255,0.14)" />
      <rect x="260" y="40" width="90" height="260" rx="10" fill="rgba(255,255,255,0.18)" />
    </svg>
  </div>
  <div class="container-site relative text-center">
    <p class="eyebrow justify-center text-ink/80 mb-5" data-reveal><span class="!bg-ink"></span>{eyebrow ?? c.finalCta.eyebrow}</p>
    <h2 id="final-cta-title" class="font-display text-display-xl text-ink mx-auto max-w-4xl" data-split>{title ?? c.finalCta.title}</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lead text-ink/80" data-reveal data-reveal-delay="1">{text ?? c.finalCta.text}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delay="2">
      <Button href={localizePath('contact', lang, 'book')} variant="secondary" size="lg" icon="calendar">{c.finalCta.button}</Button>
      <Button href={localizePath('contact', lang)} variant="ghost" size="lg" class="!border-ink/30 hover:!border-ink !text-ink hover:!bg-white/40">{c.finalCta.secondary}</Button>
    </div>
    <p class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm font-medium text-ink/70" data-reveal data-reveal-delay="3">
      <span class="whitespace-nowrap">{c.proof.consultation}</span><span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">{c.proof.reply}</span><span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">{c.proof.languages}</span>
    </p>
  </div>
</section>
<style>
  .final-cta { overflow: hidden; background: linear-gradient(135deg, #ff6b35 0%, #f7931e 55%, #ffb347 100%); min-height: min(80vh, 44rem); display: grid; align-items: center; }
  .final-cta-bg { position: absolute; inset: 0; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.7; mix-blend-mode: soft-light; }
  .orb-1 { width: 40vw; height: 40vw; left: -10vw; top: -10vw; background: #fff; animation: orb 18s ease-in-out infinite alternate; }
  .orb-2 { width: 30vw; height: 30vw; right: -5vw; bottom: -10vw; background: #ffd9a0; animation: orb 22s ease-in-out infinite alternate-reverse; }
  .orb-3 { width: 24vw; height: 24vw; left: 40%; top: 30%; background: #ff8a5c; opacity: 0.5; animation: orb 26s ease-in-out infinite alternate; }
  @keyframes orb { to { transform: translate(6vw, 4vw) scale(1.15); } }
  .steps { position: absolute; right: 0; bottom: 0; width: min(40vw, 30rem); opacity: 0.9; }
  .final-cta .eyebrow::before { background: var(--color-ink); }
  .final-cta :global(.split-w) { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .final-cta :global(.split-i) { display: inline-block; }
  @media (prefers-reduced-motion: reduce) { .orb { animation: none; } }
</style>
