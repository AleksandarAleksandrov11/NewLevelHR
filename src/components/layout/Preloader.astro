---
/** First-visit preloader (< 1 s). Visibility is decided before paint by an inline script in the head. */
import { site } from '@/config/site';
---
<div id="preloader" class="preloader" aria-hidden="true" data-preloader data-storage-key={site.storage.preloaderKey}>
  <div class="preloader-mark">
    <svg viewBox="0 0 32 32" class="preloader-glyph" aria-hidden="true">
      <rect class="pl-step" x="3" y="20" width="8" height="9" rx="2" fill="#ffb347" />
      <rect class="pl-step" x="12" y="13" width="8" height="16" rx="2" fill="#f7931e" />
      <rect class="pl-step" x="21" y="4" width="8" height="25" rx="2" fill="#ff6b35" />
    </svg>
    <span class="preloader-text">NewLevel<span class="gradient-text">HR</span></span>
  </div>
</div>
<style>
  .preloader { position: fixed; inset: 0; z-index: 2000; display: none; align-items: center; justify-content: center; background: var(--color-ivory); }
  html.is-preloading .preloader { display: flex; }
  .preloader.is-leaving { animation: pl-out 0.5s var(--ease-out-expo) forwards; }
  @keyframes pl-out { to { opacity: 0; visibility: hidden; } }
  .preloader-mark { display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; letter-spacing: -0.03em; color: var(--color-ink); animation: pl-mark 0.8s var(--ease-out-expo); }
  @keyframes pl-mark { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .preloader-glyph { width: 2.4rem; height: 2.4rem; }
  .pl-step { transform-origin: 50% 100%; animation: pl-step 0.9s var(--ease-in-out) infinite alternate; }
  .pl-step:nth-child(2) { animation-delay: 0.12s; }
  .pl-step:nth-child(3) { animation-delay: 0.24s; }
  @keyframes pl-step { from { transform: scaleY(0.55); } to { transform: scaleY(1); } }
</style>
