---
/**
 * Pixel trail: the native cursor stays visible and a grid-snapped trail of
 * pixels follows it. Enabled by src/scripts/cursor.ts only on fine pointers
 * without reduced motion; the canvas is empty and inert otherwise.
 */
---
<canvas class="cursor-trail" data-cursor-canvas aria-hidden="true"></canvas>
<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
    z-index: 900;
  }
  html.has-cursor-trail .cursor-trail { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .cursor-trail { display: none !important; }
  }
</style>
