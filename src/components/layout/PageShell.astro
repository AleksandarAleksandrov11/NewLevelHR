---
/**
 * Composes the base document with header, footer and overlays.
 * Every view renders inside a PageShell.
 */
import Base from '@/layouts/Base.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieBanner from '@/components/layout/CookieBanner.astro';
import LangBanner from '@/components/layout/LangBanner.astro';
import Cursor from '@/components/layout/Cursor.astro';
import Preloader from '@/components/layout/Preloader.astro';
import { type Locale } from '@/i18n/config';
import { alternatePaths, type PageKey } from '@/i18n/routes';
import type { SeoInput } from '@/lib/seo';

interface Props extends Omit<SeoInput, 'lang' | 'path' | 'alternates'> {
  lang: Locale;
  pageKey: PageKey | 'blogPost';
  /** Override when the page is not a registry page (blog posts). */
  path?: string;
  alternates?: Record<Locale, string>;
  jsonLd?: Array<Record<string, unknown>>;
  transparentHeader?: boolean;
  bodyClass?: string;
}
const { lang, pageKey, path, alternates, jsonLd = [], transparentHeader = false, bodyClass = '', image, ...seo } = Astro.props;
const alts = alternates ?? alternatePaths(pageKey === 'blogPost' ? 'blog' : pageKey);
const pagePath = path ?? alts[lang];
/** Open Graph image generated at build time by src/pages/og/[lang]/[key].png.ts */
const ogImage = image ?? `/og/${lang}/${pageKey === 'blogPost' ? 'blog' : pageKey}.png`;
---
<Base lang={lang} path={pagePath} alternates={alts} jsonLd={jsonLd} transparentHeader={transparentHeader} bodyClass={bodyClass} pageKey={pageKey} image={ogImage} {...seo}>
  <Header slot="header" lang={lang} alternates={alts} currentKey={pageKey} transparent={transparentHeader} />
  <slot />
  <Footer slot="footer" lang={lang} alternates={alts} />
  <Fragment slot="overlays">
    <LangBanner lang={lang} alternates={alts} />
    <CookieBanner lang={lang} />
    <Cursor />
    <Preloader />
  </Fragment>
</Base>
<script>
  import '@/scripts/app';
</script>
