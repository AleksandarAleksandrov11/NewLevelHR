---
import { ArrowUp, Mail, Clock, MapPin, Cookie, Zap } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, fmt, localizePath, type PageKey } from '@/i18n';
import { site } from '@/config/site';
import Wordmark from '@/components/ui/Wordmark.astro';
import Button from '@/components/ui/Button.astro';
import LangSwitcher from '@/components/layout/LangSwitcher.astro';

interface Props { lang: Locale; alternates: Record<Locale, string> }
const { lang, alternates } = Astro.props;
const d = getDict(lang);
const c = d.common;
const p = (k: PageKey, hash?: string) => localizePath(k, lang, hash);

const servicesLinks: Array<{ key: PageKey; label: string }> = [
  { key: 'serviceFractional', label: c.services.fractional.name },
  { key: 'serviceHiring', label: c.services.hiring.name },
  { key: 'serviceBridge', label: c.services.bridge.name },
  { key: 'serviceCoaching', label: c.services.coaching.name },
  { key: 'services', label: c.cta.allServices },
];
const companyLinks: Array<{ key: PageKey; label: string }> = [
  { key: 'about', label: c.nav.about },
  { key: 'howWeWork', label: c.nav.howWeWork },
  { key: 'problems', label: c.nav.problems },
  { key: 'blog', label: c.nav.blog },
  { key: 'healthCheck', label: c.nav.healthCheck },
  { key: 'badHireCost', label: c.nav.badHireCost },
  { key: 'faq', label: c.nav.faq },
  { key: 'contact', label: c.nav.contact },
];
const legalLinks: Array<{ key: PageKey; label: string }> = [
  { key: 'legalNotice', label: c.footer.legalNotice },
  { key: 'terms', label: c.footer.terms },
  { key: 'privacy', label: c.footer.privacy },
  { key: 'cookies', label: c.footer.cookies },
];
const wordmarkLetters = ['N', 'e', 'w', 'L', 'e', 'v', 'e', 'l', 'H', 'R'];
---
<footer class="site-footer bg-ink text-white" data-footer>
  <div class="container-site">
    <div class="footer-top">
      <div class="footer-brand" data-reveal>
        <Wordmark href={p('home')} light size="lg" label={c.meta.siteName} />
        <p class="mt-5 max-w-sm text-white/70 leading-relaxed">{c.footer.desc}</p>
        <p class="mt-3 text-sm text-white/50">{c.footer.basedIn}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href={p('contact', 'book')} icon="calendar" size="md">{c.cta.bookCall}</Button>
          <Button href={p('contact')} variant="light-ghost" icon="arrow" size="md">{c.cta.contactUs}</Button>
        </div>
      </div>

      <nav class="footer-col" aria-label={c.footer.colServices} data-reveal data-reveal-delay="1">
        <p class="footer-h">{c.footer.colServices}</p>
        <ul role="list">{servicesLinks.map((l) => <li><a href={p(l.key)} class="footer-link">{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer-col" aria-label={c.footer.colCompany} data-reveal data-reveal-delay="2">
        <p class="footer-h">{c.footer.colCompany}</p>
        <ul role="list">{companyLinks.map((l) => <li><a href={p(l.key)} class="footer-link">{l.label}</a></li>)}</ul>
      </nav>
      <div class="footer-col" data-reveal data-reveal-delay="3">
        <p class="footer-h">{c.footer.colContact}</p>
        <ul role="list" class="footer-contact">
          <li><Mail class="size-4" aria-hidden="true" /><a href={`mailto:${site.email}`} class="footer-link">{site.email}</a></li>
          <li><Clock class="size-4" aria-hidden="true" /><span><span class="block text-white/50 text-xs">{c.footer.hours}</span>{c.footer.hoursValue}</span></li>
          <li><Zap class="size-4" aria-hidden="true" /><span><span class="block text-white/50 text-xs">{c.footer.responseTime}</span>{c.footer.responseValue}</span></li>
          <li><MapPin class="size-4" aria-hidden="true" /><address class="not-italic">{c.footer.addressValue}</address></li>
        </ul>
        <nav aria-label={c.footer.colLegal} class="mt-6">
          <p class="footer-h">{c.footer.colLegal}</p>
          <ul role="list">{legalLinks.map((l) => <li><a href={p(l.key)} class="footer-link">{l.label}</a></li>)}</ul>
        </nav>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true" data-footer-wordmark>
      <span class="fw-text">
        {wordmarkLetters.map((ch, i) => <span class:list={['fw-letter', i >= 8 && 'fw-accent']} style={`--i:${i}`}>{ch}</span>)}
      </span>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer">{c.footer.disclaimer}</p>
      <div class="footer-meta">
        <p class="text-sm text-white/50">{fmt(c.footer.rights, { year: String(site.copyrightYear) })}</p>
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" class="footer-chip" data-consent-open>
            <Cookie class="size-3.5" aria-hidden="true" /><span>{c.footer.cookieSettings}</span>
          </button>
          <LangSwitcher lang={lang} alternates={alternates} light id="lang-switcher-footer" class="footer-lang" />
          <a href="#main" class="footer-chip footer-top-btn" data-back-to-top aria-label={c.cta.backToTop}>
            <ArrowUp class="size-4" aria-hidden="true" /><span class="sr-only">{c.cta.backToTop}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; padding-top: clamp(4rem, 8vw, 7rem); }
  .site-footer::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 40% at 80% 0%, rgba(255, 107, 53, 0.18), transparent 70%);
  }
  .footer-top { position: relative; display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .footer-top { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (min-width: 64rem) { .footer-top { grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 3rem; } .footer-brand { grid-column: auto; } }
  .footer-h { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin-bottom: 1rem; }
  .footer-col ul { display: grid; gap: 0.1rem; }
  /* Padding instead of gap, so every link is a 24px tap target. */
  .footer-col ul .footer-link { display: inline-block; padding-block: 0.3rem; background-position: 0 calc(100% - 0.3rem); }
  .footer-link { color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; transition: color 0.25s ease; background-image: linear-gradient(var(--color-accent-3), var(--color-accent-3)); background-size: 0% 1px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size 0.4s var(--ease-out-expo), color 0.25s ease; padding-bottom: 1px; }
  .footer-link:hover { color: #fff; background-size: 100% 1px; }
  .footer-contact li { display: flex; align-items: flex-start; gap: 0.7rem; color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; line-height: 1.45; }
  .footer-contact :global(svg) { color: var(--color-accent-3); margin-top: 0.2rem; flex: none; }

  .footer-wordmark { position: relative; margin-top: clamp(3rem, 7vw, 6rem); line-height: 0.8; overflow: hidden; user-select: none; container-type: inline-size; }
  .fw-text { display: flex; justify-content: space-between; font-family: var(--font-display); font-weight: 800; font-size: 15.2cqw; letter-spacing: -0.05em; line-height: 0.85; padding: 0.05em 0.03em 0.06em 0; }
  .fw-letter { display: inline-block; color: rgba(255, 255, 255, 0.92); transform: translateY(110%); transition: transform 1.1s var(--ease-out-expo); transition-delay: calc(var(--i) * 0.04s); }
  .fw-accent { background: var(--grad-accent); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .footer-wordmark.is-revealed .fw-letter, html:not(.js-motion) .fw-letter { transform: none; }

  .footer-bottom { position: relative; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 1rem; padding: 1.75rem 0 2.25rem; display: grid; gap: 1.25rem; }
  .footer-disclaimer { font-size: 0.78rem; line-height: 1.55; color: rgba(255, 255, 255, 0.5); max-width: 62rem; }
  .footer-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .footer-chip { display: inline-flex; align-items: center; gap: 0.4rem; height: 2.5rem; padding: 0 0.9rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.25); color: #fff; font-size: 0.8rem; font-weight: 600; background: transparent; cursor: pointer; transition: border-color 0.25s ease, background-color 0.25s ease; }
  .footer-chip:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); }
  .footer-top-btn { width: 2.5rem; padding: 0; justify-content: center; }
  .footer-lang :global(.lang-dd-menu) { top: auto; bottom: calc(100% + 0.5rem); transform-origin: bottom right; }
</style>
