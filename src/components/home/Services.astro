---
/**
 * Four service cards. Names and taglines come from common.services so they stay
 * identical across the site; the home dictionary adds the body copy and the photo.
 * The image follows the cursor slightly (src/scripts/home.ts, [data-service-img]).
 */
import { ArrowRight } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Photo from '@/components/ui/Photo.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const s = d.home.services;
const c = d.common;

const serviceMap = { serviceFractional: 'fractional', serviceHiring: 'hiring', serviceBridge: 'bridge', serviceCoaching: 'coaching' } as const;
type ServiceKey = keyof typeof serviceMap;
const cards = s.items.map((item, i) => {
  const key = item.key as ServiceKey;
  const service = c.services[serviceMap[key]];
  return {
    ...item,
    key,
    index: String(i + 1).padStart(2, '0'),
    name: service.name,
    tagline: service.tagline,
    href: localizePath(key, lang),
  };
});
---
<section id="services" class="services section bg-white">
  <div class="container-site">
    <SectionHeading eyebrow={s.eyebrow} title={s.title} />

    <ul class="services-grid" role="list">
      {cards.map((card, i) => (
        <li data-reveal data-reveal-delay={String((i % 2) + 1)}>
          <div class="svc-card" data-service-card>
            <div class="svc-media">
              <div class="svc-img" data-service-img>
                <Photo name={card.image} alt={card.name} ratio="16/10" sizes="(min-width: 64rem) 50vw, 100vw" />
              </div>
              <span class="svc-index font-display tabular" aria-hidden="true">{card.index}</span>
            </div>
            <div class="svc-body">
              <p class="svc-tagline">{card.tagline}</p>
              <h3 class="svc-name font-display"><a href={card.href} class="svc-link">{card.name}</a></h3>
              <p class="svc-text">{card.body}</p>
              <div class="svc-foot">
                <span class="svc-chip" data-magnetic="0.25" aria-hidden="true">
                  <span class="svc-chip-in"><ArrowRight class="size-5" /></span>
                </span>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="services-all" data-reveal>
      <Button href={localizePath('services', lang)} variant="secondary" size="lg">{s.all}</Button>
    </div>
  </div>
</section>

<style>
  .services-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; margin-top: 3.5rem; }
  @media (min-width: 64rem) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; } }
  .services-grid > li { display: grid; }

  .svc-card {
    position: relative;
    display: flex; flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-line);
    background: var(--color-ivory);
    box-shadow: var(--shadow-soft);
    color: inherit; text-decoration: none;
    transition: transform 0.7s var(--ease-out-expo), box-shadow 0.7s var(--ease-out-expo), border-color 0.4s ease, background-color 0.4s ease;
  }
  /* The whole card is the target, but only the name is the link: the anchor
     text is then the service, not every word printed on the card. */
  .svc-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .svc-card:has(.svc-link:focus-visible) { outline: 3px solid var(--color-accent-ink); outline-offset: 4px; border-radius: var(--radius-xl); }

  /* Media: the wrapper is oversized so the cursor nudge never reveals an edge. */
  .svc-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: calc(var(--radius-xl) - 0.75rem); background: var(--color-sand); isolation: isolate; }
  .svc-img { position: absolute; inset: -6%; will-change: transform; }
  .svc-media :global(.photo-img) { transform: scale(1); transition: transform 1.4s var(--ease-out-expo); }
  .svc-media::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 20, 28, 0) 50%, rgba(20, 20, 28, 0.42) 100%);
    opacity: 1; transition: opacity 0.8s ease;
  }
  .svc-index {
    position: absolute; left: 1.25rem; bottom: 0.85rem; z-index: 2;
    font-size: clamp(2.5rem, 2rem + 1.5vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1;
    color: #fff; text-shadow: 0 2px 24px rgba(20, 20, 28, 0.35);
    transition: transform 0.8s var(--ease-out-expo);
  }

  /* Body */
  .svc-body { display: flex; flex-direction: column; gap: 0.85rem; flex: 1; padding: 1.5rem 1rem 1rem; }
  @media (min-width: 40rem) { .svc-body { padding: 1.75rem 1.5rem 1.5rem; } }
  .svc-tagline { font-size: 0.9rem; font-weight: 600; color: var(--color-accent-ink); }
  .svc-name { font-size: var(--text-display-sm); line-height: 1.15; letter-spacing: -0.02em; font-weight: 750; color: var(--color-ink); text-wrap: balance; }
  .svc-text { color: var(--color-slate); line-height: 1.6; max-width: 38rem; }
  .svc-foot { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-top: 0.75rem; }
  .svc-chip { flex: 0 0 auto; display: block; }
  .svc-chip-in {
    display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px;
    background: var(--color-ink); color: #fff;
    transition: transform 0.6s var(--ease-out-expo), background-color 0.4s ease, color 0.4s ease;
  }
  .svc-chip-in :global(svg) { transition: transform 0.5s var(--ease-out-expo); }

  @media (hover: hover) and (pointer: fine) {
    .svc-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: rgba(255, 107, 53, 0.35); background: var(--color-white); }
    .svc-card:hover .svc-media :global(.photo-img) { transform: scale(1.07); }
    .svc-card:hover .svc-media::after { opacity: 0.6; }
    .svc-card:hover .svc-index { transform: translateY(-4px); }
    .svc-card:hover .svc-chip-in { transform: translateX(6px); background: var(--color-accent); color: var(--color-ink); }
    .svc-card:hover .svc-chip-in :global(svg) { transform: translateX(2px); }
  }

  .services-all { margin-top: 3rem; display: flex; justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .svc-card, .svc-media :global(.photo-img), .svc-index, .svc-chip-in, .svc-chip-in :global(svg) { transition: none; }
    .svc-card:hover { transform: none; }
    .svc-card:hover .svc-media :global(.photo-img) { transform: none; }
  }
</style>
