---
/**
 * Hero: one screen, one message. A soft warm wash behind the headline and
 * nothing else, and the whole block fades up once rather than word by word,
 * so the page reads as finished on the first paint.
 */
import { ArrowDown } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const h = getDict(lang).home.hero;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-wash" aria-hidden="true"></div>

  <div class="container-site hero-inner">
    <h1 id="hero-title" class="hero-title font-display">
      {h.titleLine1}<br />{h.titleLine2} <span class="accent">{h.titleAccent}</span>
    </h1>
    <p class="hero-sub text-lead text-slate">{h.sub}</p>
    <div class="hero-actions">
      <Button href={localizePath('contact', lang, 'book')} size="lg" icon="calendar">{h.cta1}</Button>
      <Button href={localizePath('services', lang)} variant="ghost" size="lg">{h.cta2}</Button>
    </div>
  </div>

  <a href="#manifesto" class="hero-scroll" aria-label={h.scroll}>
    <span aria-hidden="true">{h.scroll}</span>
    <ArrowDown class="size-4" aria-hidden="true" />
  </a>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100svh; display: grid; align-items: center;
    padding-top: calc(var(--header-h) + 2rem); padding-bottom: 5rem;
    background: var(--color-ivory);
  }
  /* One warm wash, nothing moving: the headline is the only thing to look at. */
  .hero-wash {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 55% at 50% 0%, rgba(255, 179, 71, 0.28) 0%, transparent 70%),
      radial-gradient(45% 40% at 85% 25%, rgba(255, 107, 53, 0.14) 0%, transparent 70%);
  }

  .hero-inner { position: relative; text-align: center; }
  /* The whole block arrives at once, in one short movement. */
  .js-motion .hero-inner > * { animation: hero-in 0.6s var(--ease-out-expo) both; }
  /* The headline slides without fading, so it is painted on the first frame
     and the browser can score it as the largest paint straight away. */
  .js-motion .hero-title { animation-name: hero-in-title; }
  .js-motion .hero-sub { animation-delay: 0.06s; }
  .js-motion .hero-actions { animation-delay: 0.12s; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes hero-in-title { from { transform: translateY(14px); } to { transform: none; } }

  .hero-title {
    margin-inline: auto; max-width: 18ch; color: var(--color-ink);
    font-size: clamp(2.35rem, 1.5rem + 4vw, 5.25rem); font-weight: 700;
    line-height: 1.04; letter-spacing: -0.035em; text-wrap: balance;
  }
  .hero-title .accent {
    background: var(--grad-accent); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: var(--color-accent-ink);
  }
  .hero-sub { margin: 1.75rem auto 0; max-width: 34rem; }
  .hero-actions { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem 1rem; }

  .hero-scroll {
    position: absolute; left: 50%; bottom: 1.75rem; translate: -50% 0;
    display: inline-flex; flex-direction: column; align-items: center; gap: 0.4rem;
    font-size: 0.66rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-mist); z-index: 1;
  }
  .hero-scroll :global(svg) { animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(5px); } }

  @media (max-width: 47.99rem) {
    .hero { padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 4.5rem; }
    .hero-title { max-width: none; }
    .hero-sub { margin-top: 1.25rem; }
    .hero-actions { margin-top: 2rem; }
  }
  /* Short and wide (a small laptop window, a phone on its side). */
  @media (max-height: 40rem) and (min-width: 48rem) {
    .hero { padding-top: calc(var(--header-h) + 1rem); padding-bottom: 3.5rem; }
    .hero-title { font-size: clamp(2rem, 1rem + 3.2vw, 3rem); }
    .hero-sub { margin-top: 1rem; }
    .hero-actions { margin-top: 1.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll :global(svg) { animation: none; }
  }
</style>
