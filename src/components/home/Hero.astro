---
import { ArrowDown } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const h = d.home.hero;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-bg bg-mesh" aria-hidden="true"></div>

  <div class="container-site hero-inner">
    <div class="hero-content">
      <h1 id="hero-title" class="hero-title font-display text-display-lg" data-split="immediate">
        {h.titleLine1}<br />{h.titleLine2} <span class="accent">{h.titleAccent}</span>
      </h1>
      <p class="hero-sub text-lead text-slate mt-6" data-reveal data-reveal-delay="2">{h.sub}</p>
      <div class="hero-actions mt-8" data-reveal data-reveal-delay="3">
        <Button href={localizePath('contact', lang, 'book')} size="lg" icon="calendar">{h.cta1}</Button>
        <Button href={localizePath('services', lang)} variant="ghost" size="lg">{h.cta2}</Button>
      </div>
    </div>

    <div class="hero-visual" role="img" aria-label={h.sceneLabel}>
      <svg class="hero-art" viewBox="0 0 520 420" aria-hidden="true">
        <defs>
          <linearGradient id="hf-accent" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#ff8a4c" /><stop offset="1" stop-color="#f2591f" />
          </linearGradient>
          <linearGradient id="hf-mid" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#ffd3b4" /><stop offset="1" stop-color="#ffbe93" />
          </linearGradient>
          <linearGradient id="hf-pale" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#fffaf5" /><stop offset="1" stop-color="#f7ece1" />
          </linearGradient>
          <linearGradient id="hf-light" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#f4efe9" />
          </linearGradient>
          <radialGradient id="hf-glow" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#ff6b35" stop-opacity="0.3" /><stop offset="1" stop-color="#ff6b35" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="hf-ground" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#14141c" stop-opacity="0.16" /><stop offset="1" stop-color="#14141c" stop-opacity="0" />
          </radialGradient>
          <filter id="hf-shadow" x="-25%" y="-15%" width="150%" height="150%">
            <feDropShadow dx="0" dy="16" stdDeviation="14" flood-color="#14141c" flood-opacity="0.12" />
          </filter>
        </defs>
        <circle cx="352" cy="164" r="178" fill="url(#hf-glow)" />
        <ellipse cx="270" cy="364" rx="220" ry="26" fill="url(#hf-ground)" />
        <g filter="url(#hf-shadow)">
          <rect class="hf-bar" x="60" y="252" width="86" height="98" rx="18" fill="url(#hf-light)" />
          <rect class="hf-bar" x="166" y="196" width="86" height="154" rx="18" fill="url(#hf-pale)" />
          <rect class="hf-bar" x="272" y="126" width="86" height="224" rx="18" fill="url(#hf-mid)" />
          <rect class="hf-bar" x="378" y="42" width="86" height="308" rx="18" fill="url(#hf-accent)" />
        </g>
      </svg>
    </div>
  </div>

  <a href="#manifesto" class="hero-scroll" aria-label={h.scroll}>
    <span class="hero-scroll-text" aria-hidden="true">{h.scroll}</span>
    <ArrowDown class="size-4" aria-hidden="true" />
  </a>
</section>

<style>
  .hero {
    position: relative; display: grid; align-items: center; isolation: isolate; overflow: hidden;
    padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: 4.5rem;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }

  .hero-inner { display: grid; gap: 2.5rem; align-items: center; }
  .hero-content { max-width: 36rem; }
  .hero-title { color: var(--color-ink); }
  .hero-title .accent { color: var(--color-accent-ink); }
  /* Gradient per word so it survives the split-text wrappers. */
  .hero-title .accent :global(.split-i), html:not(.js) .hero-title .accent {
    background: var(--grad-accent); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; padding-right: 0.02em;
  }
  /* Split words never break inside (overflow-wrap: anywhere would orphan trailing punctuation). */
  .hero-title :global(.split-w) { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.12em; margin-bottom: -0.12em; overflow-wrap: normal; word-break: keep-all; hyphens: manual; }
  .hero-title :global(.split-i) { display: inline-block; }
  .hero-sub { max-width: 32rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }

  /* The artwork lives in its own cell, so it can never sit under the headline. */
  .hero-visual { position: relative; width: 100%; aspect-ratio: 5 / 4; max-height: 60svh; }
  .hero-art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hf-bar { transform-box: fill-box; transform-origin: 50% 100%; animation: hf-float 6s ease-in-out infinite alternate; }
  .hf-bar:nth-child(2) { animation-delay: 0.35s; }
  .hf-bar:nth-child(3) { animation-delay: 0.7s; }
  .hf-bar:nth-child(4) { animation-delay: 1.05s; }
  @keyframes hf-float { from { transform: translateY(0); } to { transform: translateY(-9px); } }

  .hero-scroll {
    position: absolute; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
    display: none; flex-direction: column; align-items: center; gap: 0.35rem;
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-slate); z-index: 1;
  }
  .hero-scroll :global(svg) { animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(4px); } }

  @media (min-width: 48rem) {
    .hero-visual { max-height: 26rem; }
  }
  @media (min-width: 64rem) {
    .hero { min-height: 100svh; padding-bottom: 6rem; }
    .hero-inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 3.5rem; }
    .hero-visual { aspect-ratio: 1 / 1; max-height: 32rem; }
    .hero-scroll { display: inline-flex; }
  }
  @media (max-width: 47.99rem) {
    .hero { padding-top: calc(var(--header-h) + 1.75rem); padding-bottom: 3rem; }
    .hero-inner { gap: 2rem; }
    .hero-visual { aspect-ratio: 4 / 3; margin-inline: calc(-0.5 * var(--gutter)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hf-bar, .hero-scroll :global(svg) { animation: none; }
  }
</style>
