---
/**
 * Home teaser for the two free tools. They used to run inline on the home page,
 * where the calculator's total read like a price; now the visitor opens them on
 * the tools page on purpose.
 */
import { Activity, Calculator } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.tools;
const teaser = d.home.tools;
const items = [
  { icon: Activity, title: d.quiz.eyebrow, body: t.health.hero.text, href: localizePath('healthCheck', lang), cta: t.health.hero.start },
  { icon: Calculator, title: d.calculator.eyebrow, body: t.cost.hero.text, href: localizePath('badHireCost', lang), cta: d.common.cta.open },
];
---
<section class="tools-teaser section bg-white">
  <div class="container-site">
    <SectionHeading eyebrow={t.health.hero.eyebrow} title={teaser.title} text={teaser.text} />
    <ul class="tt-grid" role="list">
      {items.map((it, i) => (
        <li class="card card-hover tt-card" data-reveal data-reveal-delay={String(i + 1)} data-tilt="4">
          <span class="tt-icon"><it.icon class="size-5" aria-hidden="true" /></span>
          <h3 class="font-display text-xl font-bold text-ink mt-5">{it.title}</h3>
          <p class="mt-2 text-slate leading-relaxed">{it.body}</p>
          <a class="tt-link" href={it.href}>{it.cta}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tt-grid { display: grid; gap: 1.25rem; margin-top: 3rem; }
  @media (min-width: 48rem) { .tt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; } }
  .tt-card { position: relative; padding: 1.75rem; display: flex; flex-direction: column; }
  .tt-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.9rem; background: var(--color-accent-soft); color: var(--color-accent-ink); }
  .tt-link { margin-top: 1.25rem; align-self: flex-start; font-size: 0.9rem; font-weight: 650; color: var(--color-accent-ink); }
  /* The whole card is the target; the link stays for keyboard and screen readers. */
  .tt-link::after { content: ''; position: absolute; inset: 0; }
  .tt-link:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
