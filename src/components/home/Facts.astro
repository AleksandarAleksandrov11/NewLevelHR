---
/**
 * "What you can count on": the five verifiable facts as a strip. The KPI
 * counter row stays dormant until site.kpis.enabled is switched on with real numbers.
 */
import { type Locale } from '@/i18n/config';
import { getDict } from '@/i18n';
import { site } from '@/config/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const f = d.home.facts;
const c = d.common;
const facts = [c.facts.consultation, c.facts.bridge, c.facts.response, c.facts.languages, c.facts.hours];
type KpiId = (typeof site.kpis.items)[number]['id'];
const kpiLabel = (id: KpiId) => c.kpis[id];
---
<section id="facts" class="facts section bg-sand">
  <div class="container-site">
    <SectionHeading eyebrow={f.eyebrow} title={f.title} text={f.text} />

    <dl class="facts-grid">
      {facts.map((fact, i) => (
        <div class="fact" data-reveal data-reveal-delay={String(i + 1)}>
          <dt class="fact-label">{fact.label}</dt>
          <dd class="fact-value font-display tabular">{fact.value}</dd>
        </div>
      ))}
    </dl>

    {site.kpis.enabled && (
      <ul class="kpis" role="list">
        {site.kpis.items.map((kpi, i) => (
          <li class="kpi" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="kpi-value font-display tabular">
              <span data-counter={String(kpi.value)} data-suffix={kpi.suffix} data-decimals={String(kpi.decimals)}>{kpi.value}{kpi.suffix}</span>
              {kpi.id === 'timeToHire' && <span class="kpi-unit">{c.kpis.timeToHireUnit}</span>}
            </span>
            <span class="kpi-label">{kpiLabel(kpi.id)}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .facts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; margin-top: 3.5rem; }
  @media (min-width: 48rem) { .facts-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 2rem; } }
  @media (min-width: 64rem) { .facts-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem; } }

  .fact { position: relative; display: flex; flex-direction: column-reverse; gap: 0.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-line-strong); }
  .fact::before { content: ''; position: absolute; top: -1px; left: 0; width: 2.5rem; height: 2px; border-radius: 2px; background: var(--grad-accent); }
  .fact-value { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--color-ink); overflow-wrap: normal; }
  @media (min-width: 48rem) { .fact-value { font-size: 2.5rem; } }
  @media (min-width: 64rem) { .fact-value { font-size: clamp(1.6rem, 2.6vw, 2.75rem); } }
  .fact-label { font-size: 0.875rem; font-weight: 550; line-height: 1.4; color: var(--color-slate); }

  .kpis { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; margin-top: 3rem; }
  @media (min-width: 48rem) { .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .kpi { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.75rem; border-radius: var(--radius-lg); background: var(--color-white); border: 1px solid var(--color-line); box-shadow: var(--shadow-soft); }
  .kpi-value { display: flex; align-items: baseline; gap: 0.4rem; font-size: var(--text-display-md); font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--color-accent-ink); }
  .kpi-unit { font-size: 1rem; font-weight: 600; color: var(--color-slate); letter-spacing: 0; }
  .kpi-label { font-size: 0.875rem; font-weight: 550; color: var(--color-slate); }
</style>
