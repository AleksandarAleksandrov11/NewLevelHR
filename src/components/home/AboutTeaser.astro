---
/** Founder teaser: elegant portrait placeholder (no stock photo), the quote and the three values. */
import { Zap, HeartHandshake, Target } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import FounderPortrait from '@/components/ui/FounderPortrait.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const a = d.home.aboutTeaser;
const icons = [Zap, HeartHandshake, Target];
---
<section id="about-teaser" class="about-t section bg-mesh" aria-labelledby="about-t-title">
  <div class="container-site about-t-grid">
    <div class="about-t-media" data-parallax-scope data-reveal>
      <div data-parallax="0.12"><FounderPortrait lang={lang} name={a.name} role={a.role} /></div>
    </div>
    <div class="about-t-copy">
      <p class="eyebrow" data-reveal>{a.eyebrow}</p>
      <h2 id="about-t-title" class="font-display text-display-md text-ink mt-4" data-split>{a.title}</h2>
      <blockquote class="about-t-quote" data-reveal data-reveal-delay="1">
        <span class="about-t-mark" aria-hidden="true">&ldquo;</span>
        <p>{a.quote}</p>
        <footer class="about-t-by"><strong>{a.name}</strong><span>{a.role}</span></footer>
      </blockquote>
      <ul class="about-t-values" role="list">
        {a.values.map((v, i) => {
          const Icon = icons[i] ?? Zap;
          return (
            <li data-reveal data-reveal-delay={String(i + 2)}>
              <span class="about-t-icon"><Icon class="size-5" aria-hidden="true" /></span>
              <div>
                <h3 class="about-t-vtitle font-display">{v.title}</h3>
                <p class="about-t-vbody">{v.body}</p>
              </div>
            </li>
          );
        })}
      </ul>
      <div class="mt-9" data-reveal data-reveal-delay="5">
        <Button href={localizePath('about', lang)} variant="secondary" size="lg">{a.cta}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-t { overflow: hidden; }
  .about-t-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 64rem) { .about-t-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 5rem; } }
  .about-t-media { max-width: 26rem; margin-inline: auto; width: 100%; }
  @media (min-width: 64rem) { .about-t-media { max-width: none; } }
  .about-t-quote { position: relative; margin-top: 2rem; padding-left: 1.5rem; border-left: 3px solid var(--color-accent); }
  .about-t-quote p { font-family: var(--font-display); font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); line-height: 1.35; font-weight: 600; letter-spacing: -0.015em; color: var(--color-ink); }
  .about-t-mark { position: absolute; left: -0.35rem; top: -2.4rem; font-family: var(--font-display); font-size: 6rem; line-height: 1; font-weight: 800; color: rgba(255, 107, 53, 0.25); pointer-events: none; }
  .about-t-by { margin-top: 1rem; display: flex; flex-direction: column; font-size: 0.9rem; color: var(--color-slate); }
  .about-t-by strong { color: var(--color-ink); }
  .about-t-values { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .about-t-values li { display: flex; gap: 1rem; align-items: flex-start; }
  .about-t-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 0.9rem; background: var(--color-white); border: 1px solid var(--color-line); color: var(--color-accent-ink); box-shadow: var(--shadow-soft); }
  .about-t-vtitle { font-size: 1.05rem; font-weight: 700; color: var(--color-ink); }
  .about-t-vbody { margin-top: 0.2rem; font-size: 0.95rem; line-height: 1.55; color: var(--color-slate); }
</style>
