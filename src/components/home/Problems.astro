---
/**
 * "What we fix": four flip cards (all eight live on the What We Fix page). The
 * front names the problem, the back shows
 * how NewLevelHR fixes it and links to the matching service.
 * Tilt, spotlight and the flip toggle are driven by the shared interactions core.
 */
import { ArrowRight, Undo2 } from '@lucide/astro';
import { type Locale } from '@/i18n/config';
import { getDict, localizePath, type PageKey } from '@/i18n';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const p = d.home.problems;
const c = d.common;
/** The home page shows the first four; the What We Fix page has all eight. */
const cards = p.items.slice(0, 4).map((item, i) => ({
  ...item,
  index: String(i + 1).padStart(2, '0'),
  href: localizePath(item.service as PageKey, lang),
  backId: `problem-${item.id}-back`,
}));
---
<section id="problems" class="problems section bg-ivory bg-grain" data-problems>
  <div class="container-site">
    <SectionHeading eyebrow={p.eyebrow} title={p.title} />

    <ul class="problems-grid" role="list">
      {cards.map((card, i) => (
        <li class="problem" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <article class="problem-card" data-tilt="6" data-spotlight data-flip>
            <div class="problem-inner">
              <div class="problem-face problem-front" data-flip-front>
                <span class="problem-num font-display tabular" aria-hidden="true">{card.index}</span>
                <h3 class="problem-title font-display">{card.title}</h3>
                <p class="problem-body">{card.body}</p>
                <button type="button" class="problem-toggle" data-flip-toggle aria-expanded="false" aria-controls={card.backId}>
                  <span class="problem-toggle-icon" aria-hidden="true"><ArrowRight class="size-4" /></span>
                  <span>{p.flip}</span>
                </button>
              </div>

              <div class="problem-face problem-back" id={card.backId} data-flip-back>
                <svg class="problem-steps" viewBox="0 0 120 90" aria-hidden="true">
                  <rect x="0" y="60" width="32" height="30" rx="6" />
                  <rect x="44" y="34" width="32" height="56" rx="6" />
                  <rect x="88" y="0" width="32" height="90" rx="6" />
                </svg>
                <p class="problem-back-label">{p.flip}</p>
                <p class="problem-fix">{card.fix}</p>
                <div class="problem-back-actions">
                  <Button href={card.href} variant="secondary" size="sm" magnetic={false}>{c.cta.seeHowWeFixIt}</Button>
                  <button type="button" class="problem-toggle problem-toggle-back" data-flip-toggle aria-expanded="false" aria-controls={card.backId}>
                    <span class="problem-toggle-icon" aria-hidden="true"><Undo2 class="size-4" /></span>
                    <span>{p.back}</span>
                  </button>
                </div>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div class="problems-all" data-reveal>
      <Button href={localizePath('problems', lang)} variant="ghost" size="lg">{p.all}</Button>
    </div>
  </div>
</section>

<script>
  import '@/scripts/home-problems';
</script>

<style>
  .problems-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; margin-top: 3.5rem; }
  @media (min-width: 40rem) { .problems-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .problems-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; } }
  .problem { display: grid; }

  /* 3D stage: the card is tilted by the core, the inner element flips. */
  .problem-card { position: relative; display: grid; perspective: 1400px; transform-style: preserve-3d; }
  .problem-inner { display: grid; transform-style: preserve-3d; transition: transform 0.8s var(--ease-out-expo); }
  .problem-card.is-flipped .problem-inner { transform: rotateY(180deg); }

  /* Both faces share one grid cell so the stage grows to the taller face. */
  .problem-face {
    --face-t: box-shadow 0.6s var(--ease-out-expo), border-color 0.4s ease, background-color 0.4s ease;
    grid-area: 1 / 1;
    position: relative;
    display: flex; flex-direction: column; gap: 0.9rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
    transform: rotateY(0deg);
  }
  @media (min-width: 64rem) and (max-width: 79.99rem) { .problem-face { padding: 1.25rem; } }
  .problem-front { visibility: visible; transition: var(--face-t), visibility 0s linear 0s; }
  .problem-card.is-flipped .problem-front { visibility: hidden; transition: var(--face-t), visibility 0s linear 0.4s; }
  .problem-back { transform: rotateY(180deg); visibility: hidden; background: linear-gradient(160deg, var(--color-accent-soft) 0%, var(--color-white) 65%); border-color: rgba(255, 107, 53, 0.22); transition: var(--face-t), visibility 0s linear 0.4s; }
  .problem-card.is-flipped .problem-back { visibility: visible; transition: var(--face-t), visibility 0s linear 0s; }

  /* The card is only as tall as the face you can see, so no empty strip is left under
     the button. The hidden face is taken out of the flow and fills the cell instead. */
  .problem-card { min-height: 0; }
  .problem-inner { position: relative; }
  .problem-back { position: absolute; inset: 0; }
  .problem-card.is-flipped .problem-back { position: relative; inset: auto; }
  .problem-card.is-flipped .problem-front { position: absolute; inset: 0; }

  /* Cursor spotlight (the core sets --mx / --my on the card) */
  .problem-face::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 50%), rgba(255, 107, 53, 0.16), transparent 62%);
    opacity: 0; transition: opacity 0.5s ease;
  }
  .problem-face > * { position: relative; z-index: 1; }
  @media (hover: hover) and (pointer: fine) {
    .problem-card:hover .problem-face { border-color: rgba(255, 107, 53, 0.4); box-shadow: var(--shadow-lift); }
    .problem-card:hover .problem-face::before { opacity: 1; }
    .problem-card:hover .problem-toggle-icon { transform: rotate(-180deg); background: var(--color-accent); color: var(--color-ink); }
    .problem-toggle-back:hover .problem-toggle-icon { transform: rotate(-30deg); }
  }

  /* Front */
  .problem-num { display: flex; align-items: center; gap: 0.6rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--color-accent-ink); }
  .problem-num::after { content: ''; flex: 0 0 1.5rem; height: 2px; border-radius: 2px; background: var(--grad-accent); }
  .problem-title { font-size: 1.25rem; font-weight: 750; letter-spacing: -0.015em; line-height: 1.2; color: var(--color-ink); text-wrap: balance; }
  .problem-body { font-size: 0.9375rem; line-height: 1.55; color: var(--color-slate); }
  .problem-toggle {
    margin-top: 0.15rem; align-self: flex-start;
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.35rem 0.25rem 0.35rem 0; border: 0; background: none; cursor: pointer;
    font-size: 0.875rem; font-weight: 650; color: var(--color-accent-ink); border-radius: 999px;
  }
  /* The front toggle stretches over the whole face so a tap anywhere flips the card. */
  .problem-front .problem-toggle::after { content: ''; position: absolute; inset: 0; }
  .problem-toggle-icon {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 999px;
    background: var(--color-accent-soft); color: var(--color-accent-ink);
    transition: transform 0.6s var(--ease-out-expo), background-color 0.3s ease, color 0.3s ease;
  }
  .problem-toggle:focus-visible { outline: 3px solid var(--color-accent-ink); outline-offset: 3px; }

  /* Back */
  .problem-back-label { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-ink); }
  .problem-back-label::before { content: ''; width: 1.5rem; height: 2px; border-radius: 2px; background: var(--grad-accent); }
  .problem-fix { font-size: 0.9375rem; line-height: 1.55; font-weight: 500; color: var(--color-ink-2); }
  .problem-back-actions { margin-top: 0.35rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding-top: 0.5rem; }
  .problem-toggle-back { color: var(--color-ink-3); }
  .problem-steps { position: absolute; right: -0.5rem; bottom: -0.5rem; width: 6rem; height: auto; fill: var(--color-accent); opacity: 0.1; pointer-events: none; z-index: 0; }

  .problems-all { margin-top: 3rem; display: flex; justify-content: center; }

  /* Reduced motion: no 3D, the faces simply swap. */
  @media (prefers-reduced-motion: reduce) {
    .problem-card { perspective: none; transform-style: flat; }
    .problem-inner { transform-style: flat; }
    .problem-inner, .problem-face, .problem-card.is-flipped .problem-inner, .problem-toggle-icon { transition: none !important; transform: none !important; }
    .problem-face { -webkit-backface-visibility: visible; backface-visibility: visible; }
    .problem-face::before { display: none; }
  }
</style>
