---
/**
 * Responsive photo with AVIF/WebP sources, explicit dimensions and lazy loading.
 * Falls back to a warm gradient block when the named image does not exist.
 */
import { Picture } from 'astro:assets';
import { getPhoto } from '@/lib/images';

interface Props {
  name: string;
  alt: string;
  class?: string;
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Aspect ratio of the box, e.g. "4/3" */
  ratio?: string;
  position?: string;
}
const { name, alt, class: className = '', imgClass = '', widths = [480, 768, 1024, 1440, 1920], sizes = '(min-width: 1024px) 50vw, 100vw', loading = 'lazy', fetchpriority = 'auto', ratio, position = 'center' } = Astro.props;
const img = getPhoto(name);
const style = ratio ? `aspect-ratio:${ratio};` : undefined;
---
<div class:list={['photo overflow-hidden', className]} style={style} data-photo={name}>
  {img ? (
    <Picture
      src={img}
      alt={alt}
      widths={widths.filter((w) => w <= img.width)}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class:list={['photo-img h-full w-full object-cover', imgClass]}
      style={`object-position:${position}`}
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  ) : (
    <div class="photo-fallback h-full w-full" role="img" aria-label={alt}></div>
  )}
</div>
<style>
  .photo { position: relative; background: var(--color-sand); }
  .photo-fallback { min-height: 12rem; background: linear-gradient(135deg, #ffe3d5 0%, #f4eee6 45%, #dcebec 100%); }
</style>
