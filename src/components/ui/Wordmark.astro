---
/** Typographic logo: "NewLevel" + "HR" in accent, with the step glyph. */
interface Props {
  href?: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  light?: boolean;
  label?: string;
}
const { href = '/en/', class: className = '', size = 'md', light = false, label = 'NewLevelHR' } = Astro.props;
const sizes = { sm: 'text-[1.05rem]', md: 'text-[1.25rem]', lg: 'text-[1.6rem]' };
---
<a href={href} class:list={['wordmark group inline-flex items-center gap-2 font-display font-extrabold tracking-[-0.03em] leading-none', sizes[size], light ? 'text-white' : 'text-ink', className]} aria-label={label}>
  <svg class="wordmark-glyph size-[1.35em] shrink-0" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect class="step s1" x="3" y="20" width="8" height="9" rx="2" />
    <rect class="step s2" x="12" y="13" width="8" height="16" rx="2" />
    <rect class="step s3" x="21" y="4" width="8" height="25" rx="2" />
  </svg>
  <span class="inline-flex">
    <span>NewLevel</span><span class="wordmark-hr" aria-hidden="false">HR</span>
  </span>
</a>
<style>
  .wordmark-hr {
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.06em;
  }
  .wordmark-glyph .step { fill: url(#wm-grad); transform-origin: bottom; transition: transform 0.6s var(--ease-out-expo), opacity 0.4s ease; }
  .wordmark-glyph .s1 { fill: #ffb347; }
  .wordmark-glyph .s2 { fill: #f7931e; }
  .wordmark-glyph .s3 { fill: #ff6b35; }
  @media (hover: hover) {
    .wordmark:hover .s1 { transform: scaleY(1.15); transition-delay: 0s; }
    .wordmark:hover .s2 { transform: scaleY(1.12); transition-delay: 0.06s; }
    .wordmark:hover .s3 { transform: scaleY(1.08); transition-delay: 0.12s; }
  }
</style>
