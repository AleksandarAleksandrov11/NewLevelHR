---
/**
 * Accessible accordion item built on <details>/<summary> with animated height.
 * Group several with the same `name` for exclusive opening (native).
 */
import { Plus } from '@lucide/astro';
interface Props { question: string; name?: string; open?: boolean; class?: string; dark?: boolean; id?: string; [key: `data-${string}`]: string | undefined }
const { question, name, open = false, class: className = '', dark = false, id, ...rest } = Astro.props;
---
<details class:list={['acc group', dark ? 'acc-dark' : '', className]} name={name} open={open} id={id} data-accordion {...rest}>
  <summary class:list={['acc-summary flex w-full cursor-pointer list-none items-start justify-between gap-6 py-5 text-left font-display text-[1.05rem] font-semibold leading-snug', dark ? 'text-white' : 'text-ink']}>
    <span>{question}</span>
    <span class:list={['acc-icon mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border transition-transform duration-500 ease-out-expo group-open:rotate-45', dark ? 'border-white/25 text-white' : 'border-line-strong text-ink']} aria-hidden="true">
      <Plus class="size-4" />
    </span>
  </summary>
  <div class="acc-panel">
    <div class:list={['acc-body pb-6 pr-10 leading-relaxed', dark ? 'text-white/75' : 'text-slate']}>
      <slot />
    </div>
  </div>
</details>
<style>
  .acc { border-bottom: 1px solid var(--color-line); }
  .acc-dark { border-bottom-color: var(--color-line-dark); }
  .acc-summary::-webkit-details-marker { display: none; }
  .acc-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.55s var(--ease-out-expo); }
  .acc[open] .acc-panel { grid-template-rows: 1fr; }
  .acc-panel > .acc-body { overflow: hidden; }
  .acc-body :global(p + p) { margin-top: 0.75em; }
  .acc-body :global(a) { color: var(--color-accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .acc-dark .acc-body :global(a) { color: var(--color-accent-3); }
  .acc-body :global(ul) { list-style: disc; padding-left: 1.25em; margin-top: 0.5em; }
  .acc-body :global(li + li) { margin-top: 0.3em; }
  @media (prefers-reduced-motion: reduce) { .acc-panel { transition: none; } }
</style>
