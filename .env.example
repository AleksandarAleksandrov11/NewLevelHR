# ---------------------------------------------------------------------------
# NewLevelHR — environment variables
# Copy this file to `.env` and fill in the real values before building.
# Variables prefixed with PUBLIC_ are inlined into the client bundle.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for canonical links, hreflang,
# sitemap, Open Graph and JSON-LD.
SITE_URL=https://newlevelhr.com

# Calendly (or any scheduling tool) booking link for the free 30-minute call.
# TODO-CLIENT: replace with the real event link.
PUBLIC_BOOKING_URL=https://calendly.com/

# Where the contact form posts.
#   /api/contact  -> Vercel serverless function (api/contact.js, needs RESEND_API_KEY)
#   /contact.php  -> bundled PHP endpoint for classic PHP hosting (public/contact.php)
#   https://formspree.io/f/xxxx -> any hosted form service that accepts JSON
PUBLIC_FORM_ENDPOINT=/api/contact

# Resend API key used by api/contact.js on Vercel (https://resend.com).
RESEND_API_KEY=

# Recipient of contact-form messages (read by public/contact.php).
CONTACT_TO=info@newlevelhr.com

# Sender address used by contact.php / api/contact.js (must be a mailbox or a
# verified sender on the same domain).
CONTACT_FROM=noreply@newlevelhr.com

# Optional shared secret so that only this site can post to contact.php.
# Leave empty to disable. If set, add the same value to PUBLIC_FORM_TOKEN.
CONTACT_TOKEN=
PUBLIC_FORM_TOKEN=

# Optional privacy-friendly analytics (loaded ONLY after "analytics" consent).
# Supported: "plausible" (needs PUBLIC_ANALYTICS_DOMAIN) or empty to disable.
PUBLIC_ANALYTICS=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
